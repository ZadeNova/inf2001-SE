@startuml SD-28-reject-leave-request
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor black
skinparam ParticipantBackgroundColor white
skinparam ParticipantBorderColor black
skinparam ActorBackgroundColor white
skinparam ActorBorderColor black
skinparam BoundaryBackgroundColor white
skinparam BoundaryBorderColor black
skinparam ControlBackgroundColor white
skinparam ControlBorderColor black
skinparam EntityBackgroundColor white
skinparam EntityBorderColor black
skinparam SequenceLifeLineBorderColor black
skinparam SequenceGroupBorderColor black
skinparam SequenceGroupBackgroundColor white
skinparam SequenceReferenceBackgroundColor white
skinparam SequenceReferenceBorderColor black
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam dpi 150
hide footbox
skinparam maxMessageSize 240
skinparam sequenceParticipantFontSize 12
skinparam sequenceActorFontSize 12
autonumber
title SD-28: Reject Leave Request (UC-09)
' Traces: UC-09; FR-23, FR-64, FR-66
' Sources: DEC-13, DEC-55, DEC-56; sequence-diagram-review.md.
control ":Request\nController" as RQ
control ":Notification\nService" as NS
entity ":Leave Request" as LR
entity ":Audit Log" as AL

[-> RQ ++ : rejectLeave(request, reason)
alt no reason given
  RQ -->] : refuse until reason entered (FR-23)
else reason given
  group atomic rejection save
    RQ -> LR : reject(reason)
    RQ -> AL : record(Manager, Leave rejected)
  end
  RQ -> NS : notify(event, requester)
  ref over NS : SD-15
  NS --> RQ : delivery recorded
  RQ -->] : Rejected
end
deactivate RQ
legend bottom
Event: Leave rejected, including the supplied reason (FR-23).
Invalid input makes no change, audit or decision notification. Save
failure retains Pending (NFR-09).
endlegend
@enduml
