@startuml DP-strategy-ranking
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 150
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam noteBackgroundColor white
skinparam noteBorderColor black
hide circle
hide empty members
title DP-strategy-ranking: Strategy Pattern for Technician Ranking (excerpt of CD-final)
' Traces: FR-55, FR-56; DEC-80, DEC-81, DEC-93, DEC-96, DEC-97. Report §3.2.
' Roles: Context = CrewFormingService, StandbyActivationService; Strategy = TechnicianRanking;
' ConcreteStrategy = WorkloadRanking, ActivationRanking.

class CrewFormingService <<control>> {
 +suggestRoster(week): WeeklyRoster
 +classifyTechnicians(day)
 +formCrews(day, ranked)
 +ensureMinimumCrews(day)
}
class StandbyActivationService <<control>> {
 +listStandbysForJob(job, date, crew, outStaff): List<Standby>
}
interface TechnicianRanking <<interface>> {
 +order(candidates: List<Technician>, context): List<Technician>
}
class WorkloadRanking {
 +order(candidates, context): List<Technician>
}
class ActivationRanking {
 +order(candidates, context): List<Technician>
}
class Technician <<entity>> {
 -homeZone: Zone
 +lastWeekActiveHours(week): Decimal
 +projectedActiveHours(day): Decimal
 +projectedCreditedHours(day): Decimal
 +activationCount(asOf): Integer
}

CrewFormingService "1" o-- "1" TechnicianRanking : <<Context>> ranks with
StandbyActivationService "1" o-- "1" TechnicianRanking : <<Context>> orders with
TechnicianRanking <|.. WorkloadRanking : <<ConcreteStrategy>>
TechnicianRanking <|.. ActivationRanking : <<ConcreteStrategy>>
WorkloadRanking ..> Technician
ActivationRanking ..> Technician

note right of WorkloadRanking
 FR-55 step 4 (applied separately to the
 projected Credited under-40 h / >=40 h groups that
 classifyTechnicians() builds):
 1. last week's Active Hours (low first)
 2. projected Active Hours this week (low first)
 3. staff ID
end note
note right of ActivationRanking
 FR-56: filter eligible candidates before ordering.
 1. distinct activated dates in 12 months (few first)
 2. home-Zone distance to the Job's zone
 3. staff ID
end note
@enduml
