rectangle "N9\nstandby +=\nAlgorithm" as N9
rectangle "N10\nprojected Credited\n>= 40 h?" as N10
rectangle "N11\nbottom += t" as N11
rectangle "N12\nranked += t" as N12
rectangle "N13\nend of\niteration" as N13
rectangle "N14\nsort and\nreturn" as N14

N1 --> N2
N2 --> N3 : T
N2 --> N14 : F
N3 --> N4 : T
N3 --> N5 : F
N4 --> N2
