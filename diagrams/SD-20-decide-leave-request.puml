@startuml SD-20-decide-leave-request
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor black
skinparam ParticipantBackgroundColor white
skinparam ParticipantBorderColor black
skinparam ActorBackgroundColor white
skinparam ActorBorderColor black
skinparam BoundaryBackgroundColor white
skinparam BoundaryBorderColor black
skinparam ControlBackgroundColor white
skinparam ControlBorderColor black
skinparam EntityBackgroundColor white
skinparam EntityBorderColor black
skinparam SequenceLifeLineBorderColor black
skinparam SequenceGroupBorderColor black
skinparam SequenceGroupBackgroundColor white
skinparam SequenceReferenceBackgroundColor white
skinparam SequenceReferenceBorderColor black
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam dpi 150
hide footbox
skinparam maxMessageSize 420
skinparam wrapWidth 420
skinparam sequenceParticipantFontSize 12
skinparam sequenceActorFontSize 12
autonumber
title SD-20: Decide Leave Request (UC-09)
' Traces: UC-09; FR-22, FR-23, FR-24, FR-25, FR-49, FR-56, FR-64, FR-66, FR-70; NFR-09
' Sources: DEC-13, DEC-51, DEC-53, DEC-56, DEC-57, DEC-58; sequence-diagram-review-round-2.md.
' Round-3 source: DEC-68; sequence-diagram-review-round-3.md.
actor Manager
boundary ":RequestReviewPage" as Page
control ":RequestController" as RQ
entity "requester:Staff" as ST
entity ":LeaveRequest" as LR
control ":RosterController" as RC
control ":NotificationService" as NS
entity ":AuditLog" as AL

Manager -> Page : openPendingRequests()
activate Page
Page -> RQ ++ : listPending()
RQ --> Page -- : Pending requests; Short notice highlighted
Page --> Manager : request details and roster impact
Manager -> Page : decideRequest(request, decision, reason)
Page -> RQ ++ : decideLeave(request, decision, reason)
RQ -> RQ : checkStillPending(request)
alt no longer Pending
  RQ --> Page : current state; no second decision
else Pending
  alt reject
    alt reason missing
      RQ --> Page : refuse until reason entered (FR-23)
    else reason supplied
      group atomic rejection save
        RQ -> RQ : checkStillPending(request)
        alt still Pending
          RQ -> LR : reject(reason)
          RQ -> AL : record(Manager, Leave rejected)
        else request changed
          RQ --> Page : current state; no second decision
        end
      end
    end
  else approve
    RQ -> RQ : findCrewsOn(staff, dates)
    opt Crew affected
      RQ --> Page : Crew warning
      Page --> Manager : warning (FR-24)
      Manager -> Page : confirm(choice)
      Page -> RQ : confirm(choice)
    end
    alt Crew affected and Manager cancels
      RQ --> Page : unchanged
    else proceed
      group atomic request, balance and Crew save
        RQ -> RQ : checkStillPending(request)
        alt request changed while confirming
          RQ --> Page : current state; no second decision
        else still Pending
          RQ -> ST ++ : leaveBalance(year)
          ST --> RQ -- : remaining days
          RQ -> RQ : validateLeave(staff, dates)
          alt requested working days exceed remaining balance or overlap approved Leave
            RQ --> Page : refuse approval; Leave Request stays Pending
          else current balance and dates valid
            RQ -> LR : approve()
            note right of LR
              Deduct working days;
              Leave days count as Unavailable (FR-24/25).
            end note
            opt Crew affected
              RQ -> RC : handleCrewInvalidation(staff, dates)
              ref over RC, NS, AL : SD-16
              RC --> RQ : crewEvents and recipients
            end
            RQ -> AL : record(Manager, Leave approved)
          end
        end
      end
    end
  end
  opt valid decision save attempted
    alt save still fails after 3 retries
      RQ --> Page : Not saved; Pending; prior data retained
    else new decision committed
      opt Crew changes saved
        RQ -> NS : notify(crewEvents, crewRecipients)
        ref over NS : SD-15
        NS --> RQ : notification outcome
      end
      RQ -> NS : notify(requestDecision, requester)
      ref over NS : SD-15
      NS --> RQ : notification outcome
      RQ --> Page : Approved / Rejected
    end
  end
end
deactivate RQ
Page --> Manager : current outcome
deactivate Page
legend bottom
Balance recheck, deduction, request state and Crew changes commit together.
Approval validation excludes the selected request from overlap checks.
The balance check and deduction are serialized per Staff/calendar year (DEC-65).
Missing reason, insufficient balance, cancellation or a stale request
makes no change and sends no decision notification.
SD-16 joins this transaction and returns events; delivery follows commit.
Crew events for Draft weeks are withheld by SD-15; request decisions are delivered.
endlegend
@enduml
