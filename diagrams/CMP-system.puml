@startuml CMP-system
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 150
skinparam componentStyle uml2
skinparam ArrowColor black
skinparam componentBackgroundColor white
skinparam componentBorderColor black
skinparam interfaceBackgroundColor white
skinparam interfaceBorderColor black
skinparam packageBackgroundColor white
skinparam nodeBackgroundColor white
skinparam databaseBackgroundColor white
skinparam linetype polyline
title CMP-system: Component Diagram (M2)
' Traces: SRS v4.1; CD-final packages map 1:1 to the components below (DEC-93).
' Provided interface: component -- ()interface. Required interface: component ..> interface <<use>>.
' Sources: M2-Brief §6.5; DEC-74; DEC-80; DEC-81; DEC-88; DEC-89; NFR-13; DEC-96 to DEC-98.
left to right direction

actor Manager
actor Staff
actor "IT Administrator" as ITA

node "Web browser" {
 component "Web UI" as WebUI
}

node "On-site server" {
 package "Application layer" {
  component "Authentication" as Auth
  component "Account Management" as AccMgmt
  component "Staff Inputs" as Inputs
  component "CSV Import" as Csv
  component "Job Management" as Jobs
  component "Scheduling Engine" as Sched
  component "Roster & Hours" as Roster
  component "Notification" as Notif
  component "Audit & Retention" as Audit
 }
 package "Data layer" {
  component "Domain Model" as Domain
  database "Workload database" as DB
 }
}

component "<<system>>\nEmail Service" as EmailSvc
component "<<system>>\nSMS Gateway" as SmsSvc

' ---------- provided interfaces ----------
() "IAuthentication" as IAuth
() "IAccountAdmin" as IAcc
() "IStaffInputs" as IInputs
() "ICsvImport" as ICsv
() "IJobManagement" as IJobs
() "IScheduling" as ISched
() "IRoster" as IRoster
() "INotify" as INotify
() "IDomainModel" as IDomain
() "IPersistence" as IPersist
() "IEmailGateway" as IEmail
() "ISmsGateway" as ISms

Auth -- IAuth
AccMgmt -- IAcc
Inputs -- IInputs
Csv -- ICsv
Jobs -- IJobs
Sched -- ISched
Roster -- IRoster
Notif -- INotify
Domain -- IDomain
DB -- IPersist
EmailSvc -- IEmail
SmsSvc -- ISms

' ---------- users ----------
Manager --> WebUI
Staff --> WebUI
ITA --> WebUI

' ---------- required interfaces ----------
WebUI ..> IAuth : <<use>>
WebUI ..> IAcc : <<use>>
WebUI ..> IInputs : <<use>>
WebUI ..> ICsv : <<use>>
WebUI ..> IJobs : <<use>>
WebUI ..> IRoster : <<use>>
WebUI ..> ISched : <<use>>

Roster ..> ISched : <<use>>
Roster ..> IInputs : <<use>>
Roster ..> INotify : <<use>>
Jobs ..> INotify : <<use>>
Inputs ..> INotify : <<use>>
Inputs ..> ISched : <<use>>
AccMgmt ..> INotify : <<use>>
AccMgmt ..> IRoster : <<use>>
Auth ..> INotify : <<use>>

Auth ..> IDomain : <<use>>
AccMgmt ..> IDomain : <<use>>
Inputs ..> IDomain : <<use>>
Csv ..> IDomain : <<use>>
Jobs ..> IDomain : <<use>>
Sched ..> IDomain : <<use>>
Roster ..> IDomain : <<use>>
Notif ..> IDomain : <<use>>
Audit ..> IDomain : <<use>>
Domain ..> IPersist : <<use>>

Notif ..> IEmail : <<use>>
Notif ..> ISms : <<use>>

legend bottom
IAuthentication: logIn, confirmDevice, logOut, requestReset, resetPassword (AuthController).
IAccountAdmin: createAccount, manageAccess, updateTechnicianProfile, searchAuditLog (AccountController).
IStaffInputs: Availability, provisional picks/confirmWeek, Job Rejection submit/decide (AvailabilityController, StandbyPreferenceController, RequestController).
ICsvImport: upload(file, type) (CsvImportController; CsvRowMapper adapters inside).
IJobManagement: create/edit/delete Job, listUnassigned (JobController).
IScheduling: suggestRoster, eligible Standby ordering, minimum-coverage feasibility, check* rules (CrewFormingService, StandbyActivationService, RuleValidator).
IRoster: prepare suggestion/confirmation, Crew/direct allocation, publish, timeline, compare, replacements, Active Hours edits, dashboards (RosterController, HoursController, DashboardController).
INotify: notify(event, recipients) (NotificationService). IEmailGateway / ISmsGateway are realised through NotificationChannel.
IDomainModel: the entity classes, including AuditLog.record(). IPersistence: storage on the on-site server (NFR-13).
Audit & Retention: RetentionJob, started daily by the Clock (FR-58).
endlegend
@enduml
